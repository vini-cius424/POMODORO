# =====================================================================
# POMODORO STORE - Modele de fichier .env
#
# Copier ce fichier en ".env" dans le meme dossier, puis le remplir :
#     cp .env.exemple .env
#
# Le .env contient les secrets du site (mot de passe de la base, cles
# API). Il n'est JAMAIS versionne : ne pas l'ajouter a git, ne pas le
# copier dans un message, ne pas le mettre sur un PDF de rendu.
#
# Ce modele-ci ne contient aucune vraie valeur : lui est versionne.
# =====================================================================


# ---------------------------------------------------------------------
# Base de donnees
#
# PORT : sous WAMP, MariaDB ecoute souvent sur 3307 tandis que MySQL
# occupe le 3306. MariaDB est le bon choix ici : contrairement a
# MySQL 5.7, il applique reellement les contraintes CHECK du script de
# creation.
# ---------------------------------------------------------------------
DB_HOTE=127.0.0.1
DB_PORT=3307
DB_BASE=pomodoro
DB_UTILISATEUR=root
DB_MOT_DE_PASSE=


# ---------------------------------------------------------------------
# Adresse a laquelle on ouvre le site, SANS / final. Sert a construire
# les liens des emails et les adresses de retour apres paiement.
# Ecrite ici plutot que devinee a partir de la requete : l'en-tete Host
# peut etre falsifie, et un lien pointerait alors vers un site pirate.
# ---------------------------------------------------------------------
URL_SITE=http://localhost:8000


# ---------------------------------------------------------------------
# Fichier de certificats racine pour les requetes HTTPS (Brevo, Stripe).
# Sous WAMP, PHP n'en a aucun par defaut (erreur cURL 60 "unable to get
# local issuer certificate"). Git pour Windows en fournit un :
#     CERTIFICATS="C:/Program Files/Git/mingw64/ssl/certs/ca-bundle.crt"
# Sinon, telecharger https://curl.se/ca/cacert.pem et indiquer son
# chemin. Vide = certificats du systeme (Linux, macOS).
# ---------------------------------------------------------------------
CERTIFICATS=


# ---------------------------------------------------------------------
# Brevo (emails) - facultatif
#
# Sans cle, le site fonctionne quand meme : les comptes sont crees
# directement confirmes et la newsletter affiche "pas encore disponible".
# ---------------------------------------------------------------------

# Brevo > SMTP et API > Cles API.
BREVO_CLE_API=

# Adresse validee dans Brevo > Expediteurs. Les emails partent "de" elle.
BREVO_EXPEDITEUR_EMAIL=
BREVO_EXPEDITEUR_NOM="Pomodoro Store"

# Boite qui recoit les notifications (nouveau message du formulaire de
# contact). Vide = l'adresse expediteur ci-dessus.
BREVO_EMAIL_NOTIFICATIONS=

# Newsletter : ID de la liste (Contacts > Listes) et ID du modele
# d'email de confirmation "double opt-in". 0 = newsletter desactivee.
BREVO_LISTE_NEWSLETTER=0
BREVO_MODELE_DOUBLE_OPTIN=0


# ---------------------------------------------------------------------
# Stripe (paiement) - facultatif
#
# Sans cle, la commande est enregistree sans paiement.
# ---------------------------------------------------------------------

# Stripe > Developpeurs > Cles API, en MODE TEST : commence par
# "sk_test_". Ne jamais mettre une cle "sk_live_" (vrai argent).
STRIPE_CLE_SECRETE=

# Monnaie des paiements, en minuscules (code ISO) : franc suisse.
STRIPE_DEVISE=chf
