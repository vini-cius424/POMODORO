# Secrets : tout est dans le .env (ignore plus haut), le modele a copier
# est .env.exemple, lui versionne. On garde .env.exemple meme si une
# regle plus large venait a l'attraper.
!.env.exemple

# Anciens fichiers de config (avant le .env). Ignores PARTOUT dans le
# projet, pas seulement dans back-end/ : une copie posee a la racine a
# deja fini dans un commit avec les vraies cles.
config-brevo.php
config-stripe.php

# Sauvegardes d'editeur SQL
*.~sql
